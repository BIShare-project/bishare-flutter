          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BIShare liest das geteilte Live Photo, um Foto und Bewegung zusammen zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BIShare reads the Live Photo you share so it can send the photo and its motion together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
