  "strings" : {
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعثر BIShare على الأجهزة القريبة وينقل الملفات عبر شبكتك المحلية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BIShare findet Geräte in der Nähe und überträgt Dateien über dein lokales Netzwerk."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BIShare needs local network access to discover and send files to nearby devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BIShare encuentra dispositivos cercanos y transfiere archivos por tu red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BIShare trouve les appareils à proximité et transfère les fichiers sur votre réseau local."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BIShare आस-पास के डिवाइस ढूँढता है और आपके लोकल नेटवर्क पर फ़ाइलें भेजता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BIShare menemukan perangkat terdekat dan mengirim file lewat jaringan lokal Anda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BIShareは近くのデバイスを見つけ、ローカルネットワーク経由でファイルを転送します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BIShare는 주변 기기를 찾고 로컬 네트워크로 파일을 전송합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O BIShare encontra dispositivos próximos e transfere arquivos pela sua rede local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BIShare находит устройства рядом и передаёт файлы по вашей локальной сети."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BIShare 通过本地网络查找附近的设备并传输文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BIShare 透過區域網路尋找附近的裝置並傳輸檔案。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
