<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV home-screen banner (landscape). The launcher icon is centered
     on a dark brand background so it reads well in the Leanback launcher row,
     instead of a stretched square app icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0A0A" />
        </shape>
    </item>
    <item
        android:width="104dp"
        android:height="104dp"
        android:drawable="@mipmap/ic_launcher"
        android:gravity="center" />
</layer-list>
